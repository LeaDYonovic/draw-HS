{
  "name": "hearth-draw-guess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "check": "npm test && npm run build",
    "start": "npm run build && node server/index.mjs",
    "server": "node server/index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
