[Unit]
Description=Hearth Draw real-time game server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=li
Group=li
WorkingDirectory=/home/li/apps/hearth-draw
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=CARD_IMAGE_DIR=/var/lib/hearth-draw/card-images
Environment=MAX_ROOMS=100
Environment=MAX_IMAGE_FETCHES=4
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
MemoryMax=512M
TasksMax=128
StateDirectory=hearth-draw
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
